{
  "name": "hfg8-unicri-stop-before-it-starts",
  "version": "0.1.0",
  "description": "Hackathon for Good #8 — UNICRI challenge: plug-and-play prevention for platforms",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names platform,backend \"vite --config vite.config.js\" \"node starter-backend/server.js\"",
    "check": "node tools/check-safety.js",
    "test": "node --test test/check-safety.test.js",
    "generate:traffic": "node tools/generate-traffic.js",
    "dashboard": "vite dev --config vite-dashboard.config.js"
  },
  "keywords": [
    "hackathon",
    "prevention",
    "child-safety",
    "plug-and-play",
    "unicri"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
